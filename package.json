{
  "name": "catalyst-doc",
  "version": "0.1.0",
  "private": true,
  "description": "Catalyst product documentation site (docs.catalystctl.com) — Astro Starlight, deployed on Cloudflare Pages.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/sync-openapi.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "node scripts/validate-docs.mjs",
    "sync-openapi": "node scripts/sync-openapi.mjs",
    "check-terminology": "node scripts/check-terminology.mjs",
    "docs-agent": "node tools/docs-agent/bin/docs-agent.mjs",
    "test": "node --test tools/docs-agent/tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.1",
    "astro": "^7.2.10",
    "sharp": "^0.34.2"
  }
}
