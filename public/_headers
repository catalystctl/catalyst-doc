# Cloudflare Pages response headers for docs.catalystctl.com.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Machine-readable documentation artifacts: plain text, short shared cache so a
# regenerated index goes live quickly.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# The OpenAPI contract changes with panel releases, not with every deploy.
/openapi.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

# Fingerprinted build assets never change under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
